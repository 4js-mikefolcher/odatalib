<?xml version="1.0" encoding="UTF-8" ?>
<!--
  GAS deployment descriptor for the Northwind OData service.

  Deploys NorthwindService as a GAS REST web service. Once registered with a
  GAS dispatcher, the OData endpoints are reachable at:

      http://<host>:<port>/<connector>/ws/r/northwind/northwind/

  where the first "northwind" is this application (the .xcf name) and the second
  is the OData service name passed to RegisterRestService(). For example:

      GET .../ws/r/northwind/northwind/                       (service document)
      GET .../ws/r/northwind/northwind/$metadata              (CSDL)
      GET .../ws/r/northwind/northwind/Customers?$top=10&$count=true
      GET .../ws/r/northwind/northwind/Customers('ALFKI')
      GET .../ws/r/northwind/northwind/CountrySummary         (function provider)

  Adjust odata.project.dir to the absolute path of this checkout before use.
-->
<APPLICATION Parent="ws.default"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="https://4js.com/ns/gas/6.00/cfextws.xsd">

  <!-- Absolute path to the project checkout (edit for your machine). -->
  <RESOURCE Id="odata.project.dir" Source="INTERNAL">/Volumes/SandiskSD/fgl-odata</RESOURCE>

  <EXECUTION>
    <!-- Resolve the odatalib package and the example modules. -->
    <ENVIRONMENT_VARIABLE Id="FGLLDPATH" Concat="APPEND">$(odata.project.dir):$(odata.project.dir)/examples</ENVIRONMENT_VARIABLE>

    <!-- Absolute path to the .odata config (the DVM cwd is not the examples dir). -->
    <ENVIRONMENT_VARIABLE Id="ODATA_CONFIG">$(odata.project.dir)/examples/northwind.odata</ENVIRONMENT_VARIABLE>

    <!-- Web-service engine timeouts (seconds). -->
    <ENVIRONMENT_VARIABLE Id="GWS_CONNECTTIMEOUT">25</ENVIRONMENT_VARIABLE>
    <ENVIRONMENT_VARIABLE Id="GWS_RWTIMEOUT">60</ENVIRONMENT_VARIABLE>
    <ENVIRONMENT_VARIABLE Id="GWS_SERVERTIMEOUT">120</ENVIRONMENT_VARIABLE>

    <!-- Logging while bringing the service up (raise FGLWSDEBUG to debug). -->
    <ENVIRONMENT_VARIABLE Id="FGLWSDEBUG">0</ENVIRONMENT_VARIABLE>

    <!-- Directory containing the compiled NorthwindService program. -->
    <PATH>$(odata.project.dir)/examples</PATH>
    <MODULE>NorthwindService</MODULE>

    <!-- Open for the first routing tests; tighten before any real exposure. -->
    <ACCESS_CONTROL>
      <ALLOW_FROM>ALL</ALLOW_FROM>
    </ACCESS_CONTROL>

    <POOL>
      <START>1</START>
      <MIN_AVAILABLE>1</MIN_AVAILABLE>
      <MAX_AVAILABLE>5</MAX_AVAILABLE>
    </POOL>
  </EXECUTION>
</APPLICATION>
